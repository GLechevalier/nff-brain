{
  "name": "@nff-brain/core",
  "version": "0.1.0",
  "description": "Knowledge-graph memory primitives — graph types, deterministic layout, lexical scoring.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GLechevalier/nff-brain.git",
    "directory": "packages/core"
  },
  "keywords": [
    "knowledge-graph",
    "memory",
    "graph-layout",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "nff-brain-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./score": {
      "nff-brain-source": "./src/score.ts",
      "types": "./dist/score.d.ts",
      "default": "./dist/score.js"
    },
    "./vector": {
      "nff-brain-source": "./src/vector.ts",
      "types": "./dist/vector.d.ts",
      "default": "./dist/vector.js"
    },
    "./rank": {
      "nff-brain-source": "./src/rank.ts",
      "types": "./dist/rank.d.ts",
      "default": "./dist/rank.js"
    },
    "./activity": {
      "nff-brain-source": "./src/activity.ts",
      "types": "./dist/activity.d.ts",
      "default": "./dist/activity.js"
    },
    "./layout": {
      "nff-brain-source": "./src/layout.ts",
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./spine": {
      "nff-brain-source": "./src/spine.ts",
      "types": "./dist/spine.d.ts",
      "default": "./dist/spine.js"
    },
    "./types": {
      "nff-brain-source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./brainGraph": {
      "nff-brain-source": "./src/brainGraph.ts",
      "types": "./dist/brainGraph.d.ts",
      "default": "./dist/brainGraph.js"
    },
    "./clip": {
      "nff-brain-source": "./src/clip.ts",
      "types": "./dist/clip.d.ts",
      "default": "./dist/clip.js"
    },
    "./clipDistill": {
      "nff-brain-source": "./src/clipDistill.ts",
      "types": "./dist/clipDistill.d.ts",
      "default": "./dist/clipDistill.js"
    },
    "./clipApply": {
      "nff-brain-source": "./src/clipApply.ts",
      "types": "./dist/clipApply.d.ts",
      "default": "./dist/clipApply.js"
    },
    "./chatPrompt": {
      "nff-brain-source": "./src/chatPrompt.ts",
      "types": "./dist/chatPrompt.d.ts",
      "default": "./dist/chatPrompt.js"
    },
    "./jsonExtract": {
      "nff-brain-source": "./src/jsonExtract.ts",
      "types": "./dist/jsonExtract.d.ts",
      "default": "./dist/jsonExtract.js"
    },
    "./provider": {
      "nff-brain-source": "./src/provider.ts",
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./browserVerbs": {
      "nff-brain-source": "./src/browserVerbs.ts",
      "types": "./dist/browserVerbs.d.ts",
      "default": "./dist/browserVerbs.js"
    },
    "./pageSnapshot": {
      "nff-brain-source": "./src/pageSnapshot.ts",
      "types": "./dist/pageSnapshot.d.ts",
      "default": "./dist/pageSnapshot.js"
    }
  }
}
