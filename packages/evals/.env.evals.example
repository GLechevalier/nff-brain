# Copy to .env.evals (gitignored) and fill in. All accounts are DEDICATED
# eval accounts — never personal ones.

# Google OAuth desktop client (Cloud project owned by the eval Google account,
# Gmail + Calendar + Drive APIs enabled). setup:google mints .auth/google.json.
NFF_EVALS_GOOGLE_CLIENT_ID=
NFF_EVALS_GOOGLE_CLIENT_SECRET=

# Slack: bot token (chat:write, channels:manage, channels:read, channels:history)
# for the owned eval workspace.
NFF_EVALS_SLACK_BOT_TOKEN=

# Notion internal integration token + the Deals database id it is shared with.
NFF_EVALS_NOTION_TOKEN=
NFF_EVALS_NOTION_DEALS_DB=

# nff-admin CRM MCP endpoint (dev) — reserved, wired in the crm ladder wave.
NFF_EVALS_NFFCRM_MCP_URL=

# LinkedIn eval-account allowlist (preflight refuses to run destructive
# scenarios when the profile's session belongs to any other account).
NFF_EVALS_LINKEDIN_ACCOUNT=
